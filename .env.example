# 复制为 .env 并填入真实值: cp .env.example .env
# Alpaca 模拟盘 API 密钥(在 https://app.alpaca.markets/account/configuration 生成)
APCA_API_KEY_ID=你的KeyID
APCA_API_SECRET_KEY=你的Secret

# --- TradingView webhook 接收服务 (webhook_server.py) ---
# 随机串,生成方法: python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=
# 信号确认专用 Telegram bot(找 @BotFather 新建,与 Hermes 的 bot 分开)
TG_BOT_TOKEN=
# 你的 Telegram 数字 chat id(私聊 @userinfobot 可查),既是推送目标也是操作白名单
TG_CHAT_ID=

# --- Hermes trader profile 用的模型 key(README 第 3 步第 6 点)---
# 注意:写入 ~/.hermes/profiles/trader/.env 时变量名要改成
# KIMI_API_KEY / DEEPSEEK_API_KEY(Hermes 只认这两个名字)
# Kimi/Moonshot 国际版 key(platform.moonshot.ai),主力模型 kimi-k3
KIMI3_API_KEY=
# DeepSeek key(platform.deepseek.com),fallback 模型 deepseek-v4-pro
DEEPSEEK_API_KEY=
